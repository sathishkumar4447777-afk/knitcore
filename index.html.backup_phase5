    <!-- Account Details Section -->
    <section class="section section-white" id="account-details">
      <div class="wrap">
        <div class="section-head">
          <h2 data-en="Account Details" data-ta="கணக்கு விவரங்கள்">Account Details</h2>
          <p data-en="Your authenticated profile information." data-ta="உங்கள் கணக்கு விவரக்குறிப்பு.">Your authenticated profile information.</p>
        </div>
        <div class="panel" id="accountProfileCard">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px">
            <div>
              <h3 id="profileFullName" style="margin:0 0 4px;color:var(--navy);font-size:20px"></h3>
              <p id="profileEmail" style="margin:0 0 10px;color:var(--muted);font-size:14px"></p>
              <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                <span id="profileRoleTag" class="tag tag-blue"></span>
                <span id="profileVerificationTag" class="tag hidden"></span>
              </div>
              <div id="employerDetailsBox" style="margin-top:12px;font-size:14px;color:var(--muted)"></div>
            </div>
            <button class="btn btn-outline btn-sm" id="profileLogoutBtn" type="button" data-en="Log Out" data-ta="வெளியேறு">Log Out</button>
          </div>
        </div>
      </div>
    </section>
  </div>
</main>
<footer><div class="wrap"><span data-en="Tiruppur Thozhil · Local garment job connection" data-ta="திருப்பூர் தொழில் · உள்ளூர் பின்னலாடை வேலைவாய்ப்பு">Tiruppur Thozhil · Local garment job connection</span></div></footer>

<script>
(function(){
  const SUPABASE_URL = 'https://kbdyhuplufppeumwoktv.supabase.co';
  const SUPABASE_ANON_KEY = 'sb_publishable_2MWCjW5HkBGXWUdc1Ez5Kw_Zs4-hYPX';
  const supabase = (window.supabase && SUPABASE_URL && SUPABASE_ANON_KEY)
    ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY)
    : null;

  const areas=['Tiruppur Central','Kumaran Road','Anupparpalayam','Veerapandi','Andipalayam','Pichampalayam','Mangalam','Perumanallur','Avinashi','Palladam','Kangeyam'];
  const categories=[
    {en:'All',ta:'அனைத்தும்'},
    {en:'Tailor',ta:'தையல்காரர்'},
    {en:'Overlock Operator',ta:'ஓவர்லாக் ஆபரேட்டர்'},
    {en:'Checker',ta:'தரச் சரிபார்ப்பாளர்'},
    {en:'Ironing',ta:'அயர்னிங்'},
    {en:'Packing',ta:'பேக்கிங்'},
    {en:'Cutting Master',ta:'கட்டிங் மாஸ்டர்'},
    {en:'Helper',ta:'உதவியாளர்'}
  ];
  let lang='en', selectedCategory='All', gpsPosition=null, jobs=[], nextId=1;
  let currentUser = null; // { user, profile, employerProfile }

  const $=id=>document.getElementById(id);
  const translated=(en,ta)=>lang==='ta'?ta:en;
  function optionHtml(value,label){return `<option value="${escapeHtml(value)}">${escapeHtml(label)}</option>`}
  function escapeHtml(value){return String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

  function fillAreaSelect(id,allOption=false){
    const select=$(id);
    if(!select) return;
    select.innerHTML=(allOption?optionHtml('',translated('All Tiruppur areas','திருப்பூரின் அனைத்து பகுதிகளும்')):'')+areas.map(a=>optionHtml(a,a)).join('');
  }
  function fillCategorySelect(id,allOption=false){
    const select=$(id);
    if(!select) return;
    select.innerHTML=categories.filter(c=>allOption||c.en!=='All').map(c=>optionHtml(c.en,lang==='ta'?c.ta:c.en)).join('');
  }

  function setLanguage(newLang){
    lang=newLang;document.documentElement.lang=lang==='ta'?'ta':'en';
    document.querySelectorAll('[data-en][data-ta]').forEach(el=>{
      el.textContent=el.dataset[lang];
    });
    document.querySelectorAll('[data-set-lang]').forEach(b=>b.classList.toggle('active',b.dataset.setLang===lang));
    fillAreaSelect('areaSelect',true);
    fillAreaSelect('jobArea');
    fillAreaSelect('regArea');
    fillAreaSelect('empArea');
    fillCategorySelect('jobTitle');
    fillCategorySelect('skills');
    renderCategories();
    renderJobs();
    renderAuthUI();
    $('locationStatus').textContent=gpsPosition?translated('Location access is on.','இருப்பிட அணுகல் இயக்கத்தில் உள்ளது.'):translated('You can also choose an area above.','மேலே உள்ள பட்டியலில் பகுதியையும் தேர்ந்தெடுக்கலாம்.');
  }
  document.querySelectorAll('[data-set-lang]').forEach(b=>b.addEventListener('click',()=>setLanguage(b.dataset.setLang)));

  function renderCategories(){
    $('categories').innerHTML=categories.map(c=>`<button type="button" class="category ${selectedCategory===c.en?'active':''}" data-category="${escapeHtml(c.en)}">${escapeHtml(lang==='ta'?c.ta:c.en)}</button>`).join('');
    $('categories').querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{selectedCategory=b.dataset.category;renderCategories();renderJobs();}));
  }

  function demoJobs(){
    return [
      {id:nextId++,title:'Tailor',company:'Sample Garment Unit',area:'Veerapandi',payType:'',phone:'',description:'Demo listing — replace with a real employer post.',created:Date.now()-1000,demo:true},
      {id:nextId++,title:'Packing',company:'Sample Knitwear Unit',area:'Anupparpalayam',payType:'Daily Salary',phone:'',description:'Demo listing — replace with a real employer post.',created:Date.now()-2000,demo:true}
    ];
  }

  function renderJobs(){
    const area=$('areaSelect').value, sort=$('sortSelect').value;
    let visible=jobs.filter(j=>(selectedCategory==='All'||j.title===selectedCategory)&&(!area||j.area===area));
    if(sort==='latest') visible.sort((a,b)=>b.created-a.created);
    else if(sort==='area'&&area) visible.sort((a,b)=>(a.area===area?-1:0)-(b.area===area?-1:0));
    else if(sort==='nearest'&&gpsPosition) visible.sort((a,b)=>distanceFor(a)-distanceFor(b));
    const root=$('jobList');
    if(!visible.length){root.innerHTML=`<div class="empty">${escapeHtml(translated('No jobs found. Try another area or category.','வேலைகள் இல்லை. வேறு பகுதி அல்லது வேலை வகையைத் தேர்ந்தெடுக்கவும்.'))}</div>`;return;}
    root.innerHTML=visible.map(j=>{
      const demo=j.demo?`<span class="tag">${escapeHtml(translated('Demo listing','மாதிரி பதிவு'))}</span>`:'';
      const pay=j.payType?`<span class="tag">${escapeHtml(translated(j.payType,j.payType==='Daily Salary'?'தினசரி சம்பளம்':'வாரச் சம்பளம்'))}</span>`:'';
      const phone=j.phone?`<a class="btn btn-primary" href="tel:${escapeHtml(j.phone.replace(/[^\d+]/g,''))}">${escapeHtml(translated('Call','அழைக்க'))}</a>`:`<button class="btn btn-outline" type="button" disabled>${escapeHtml(translated('Call','அழைக்க'))}</button>`;
      const details=j.description?`<div class="job-meta">${escapeHtml(j.description)}</div>`:'';
      return `<article class="job-card"><div class="job-meta">${escapeHtml(j.title)}</div><h3>${escapeHtml(j.company)}</h3><div class="job-company">${escapeHtml(j.area)}</div><div class="job-tags">${pay}${demo}</div>${details}<div class="job-actions">${phone}</div></article>`;
    }).join('');
  }

  function distanceFor(){return 0;}

  $('areaSelect').addEventListener('change',renderJobs);
  $('sortSelect').addEventListener('change',()=>{
    if($('sortSelect').value==='nearest'&&!gpsPosition){
      $('locationStatus').textContent=translated('Allow location access first.','முதலில் இருப்பிட அனுமதி வழங்கவும்.');
      $('sortSelect').value='area';return;
    }
    if($('sortSelect').value==='nearest'){
      $('locationStatus').textContent=translated('GPS is enabled. Real distances need verified job coordinates.','GPS இயக்கத்தில் உள்ளது. தூரத்தைக் கணக்கிட வேலை இடத்தின் சரியான coordinates தேவை.');
    }
    renderJobs();
  });

  $('useLocation').addEventListener('click',()=>{
    const status=$('locationStatus');
    if(!navigator.geolocation){status.textContent=translated('Location is not supported by this browser. Choose an area instead.','இந்த உலாவியில் இருப்பிட வசதி இல்லை. பகுதியைத் தேர்ந்தெடுக்கவும்.');return;}
    status.textContent=translated('Requesting location permission…','இருப்பிட அனுமதி கோரப்படுகிறது…');
    navigator.geolocation.getCurrentPosition(pos=>{
      gpsPosition={latitude:pos.coords.latitude,longitude:pos.coords.longitude};
      status.textContent=translated('Location permission granted. Choose an area if needed. Exact distances require job coordinates.','இருப்பிட அனுமதி கிடைத்தது. தேவையெனில் பகுதியைத் தேர்ந்தெடுக்கவும். சரியான தூரத்திற்கு வேலை இடத்தின் coordinates தேவை.');
      $('sortSelect').value='nearest';renderJobs();
    },()=>{
      gpsPosition=null;status.textContent=translated('Location unavailable or permission denied. Choose your area manually.','இருப்பிடத்தைப் பெற முடியவில்லை அல்லது அனுமதி மறுக்கப்பட்டது. பகுதியைத் தேர்ந்தெடுக்கவும்.');
    },{enableHighAccuracy:false,timeout:10000,maximumAge:300000});
  });

  // Password visibility toggles
  function setupPasswordToggle(btnId, inputId){
    const btn=$(btnId), input=$(inputId);
    if(!btn||!input) return;
    btn.addEventListener('click',()=>{
      const isPassword=input.type==='password';
      input.type=isPassword?'text':'password';
      const span=btn.querySelector('span');
      if(span){
        span.textContent=isPassword?translated('Hide','மறை'):translated('Show','காட்டு');
      }
    });
  }
  setupPasswordToggle('toggleLoginPassword','loginPassword');
  setupPasswordToggle('toggleRegPassword','regPassword');

  // Auth Tab Switchers (Page 1)
  $('tabLogin').addEventListener('click',()=>{
    $('tabLogin').classList.add('active');
    $('tabRegister').classList.remove('active');
    $('loginForm').classList.remove('hidden');
    $('registerForm').classList.add('hidden');
    $('loginStatus').textContent='';
  });
  $('tabRegister').addEventListener('click',()=>{
    $('tabRegister').classList.add('active');
    $('tabLogin').classList.remove('active');
    $('registerForm').classList.remove('hidden');
    $('loginForm').classList.add('hidden');
    $('registerStatus').textContent='';
  });

  // Role toggle in registration form
  $('userRole').addEventListener('change',()=>{
    const isWorker=$('userRole').value==='worker';
    $('workerAreaField').classList.toggle('hidden',!isWorker);
    $('skillsField').classList.toggle('hidden',!isWorker);
    $('companyField').classList.toggle('hidden',isWorker);
    $('empAreaField').classList.toggle('hidden',isWorker);
    $('companyName').required=!isWorker;
  });

  // User State Management & Auth UI Rendering
  async function loadUserProfile(user){
    if(!user||!supabase){
      currentUser=null;
      renderAuthUI();
      return;
    }
    try{
      // 1. Fetch user profile from public.profiles
      const { data: profile } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', user.id)
        .maybeSingle();

      // 2. Fetch employer profile if exists
      let { data: employerProfile } = await supabase
        .from('employer_profiles')
        .select('*')
        .eq('user_id', user.id)
        .maybeSingle();

      // 3. Fallback for Employer Registration after Email Confirmation:
      const meta = user.user_metadata || {};
      if(!employerProfile && meta.intended_role==='employer' && meta.company_name){
        try{
          const { error: rpcErr } = await supabase.rpc('register_as_employer', {
            p_company_name: meta.company_name,
            p_area: meta.area || null
          });
          if(!rpcErr){
            const { data: newEp } = await supabase
              .from('employer_profiles')
              .select('*')
              .eq('user_id', user.id)
              .maybeSingle();
            employerProfile = newEp;

            const { data: updatedProfile } = await supabase
              .from('profiles')
              .select('*')
              .eq('id', user.id)
              .maybeSingle();
            if(updatedProfile) currentUser={ user, profile: updatedProfile, employerProfile };
          } else {
            console.warn('register_as_employer RPC error:', rpcErr);
          }
        }catch(rpcEx){
          console.warn('register_as_employer execution notice:', rpcEx);
        }
      }

      currentUser = { user, profile, employerProfile };
    }catch(err){
      console.warn('Error fetching user details:', err);
      currentUser = { user, profile: null, employerProfile: null };
    }
    renderAuthUI();
  }

  function renderAuthUI(){
    const viewLogin=$('viewLogin');
    const viewDashboard=$('viewDashboard');
    const headerState=$('authHeaderState');

    if(!currentUser || !currentUser.user){
      // ================= PAGE 1: SHOW LOGIN VIEW =================
      viewLogin.classList.remove('hidden');
      viewDashboard.classList.add('hidden');

      // Topbar for Page 1
      headerState.innerHTML=`
        <button class="btn btn-outline btn-sm" type="button" id="topLoginFocusBtn" data-en="Log In" data-ta="உள்நுழைய">${escapeHtml(translated('Log In','உள்நுழைய'))}</button>
      `;
      const focusBtn=$('topLoginFocusBtn');
      if(focusBtn){
        focusBtn.addEventListener('click', ()=>{
          $('tabLogin').click();
          $('loginEmail').focus();
        });
      }
      return;
    }

    // ================= PAGE 2: SHOW DASHBOARD VIEW =================
    viewLogin.classList.add('hidden');
    viewDashboard.classList.remove('hidden');

    const user = currentUser.user;
    const profile = currentUser.profile;
    const employerProfile = currentUser.employerProfile;
    const displayName = profile?.full_name || user.user_metadata?.full_name || user.email;
    const role = profile?.role || 'worker'; // Never grant roles based on user-controlled form values

    const roleLabel = role==='employer'
      ? translated('Employer','நிறுவனம்')
      : translated('Worker','தொழிலாளர்');

    // Header State on Dashboard
    headerState.innerHTML=`
      <div class="user-chip">
        <span class="user-name" title="${escapeHtml(displayName)}">${escapeHtml(displayName)}</span>
        <span class="tag tag-blue">${escapeHtml(roleLabel)}</span>
        <button class="btn btn-outline btn-sm" id="headerLogoutBtn" type="button">${escapeHtml(translated('Logout','வெளியேறு'))}</button>
      </div>
    `;
    const hLogout=$('headerLogoutBtn');
    if(hLogout) hLogout.addEventListener('click', handleLogout);

    // Dashboard Banner
    $('dashWelcomeName').textContent = displayName;
    $('dashRoleBadge').textContent = roleLabel;

    const dashVerifBadge=$('dashVerifBadge');
    const dashEmployerInfo=$('dashEmployerInfo');
    const dashPostJobBtn=$('dashPostJobBtn');
    const postGate=$('jobPostGate');
    const jobForm=$('jobForm');
    const gateTitle=$('gateTitle');
    const gateDesc=$('gateDesc');

    // Role-specific configuration
    if(role==='employer'){
      const vStatus = employerProfile?.verification_status || 'pending';
      dashVerifBadge.classList.remove('hidden');
      dashPostJobBtn.classList.remove('hidden');

      if(vStatus==='approved'){
        dashVerifBadge.className='tag';
        dashVerifBadge.textContent=translated('Verified Employer','சரிபார்க்கப்பட்ட நிறுவனம்');

        postGate.className='status-banner verified';
        gateTitle.textContent=translated('Verified Employer Account','சரிபார்க்கப்பட்ட நிறுவனக் கணக்கு');
        gateDesc.textContent=translated('Your employer account is verified. You can post job openings below.','உங்கள் கணக்கு சரிபார்க்கப்பட்டது. கீழே வேலை வாய்ப்புகளைப் பதிவு செய்யலாம்.');
        jobForm.classList.remove('hidden');

        if(employerProfile?.company_name) $('company').value = employerProfile.company_name;
        if(employerProfile?.area) $('jobArea').value = employerProfile.area;
      } else {
        dashVerifBadge.className='tag tag-warn';
        dashVerifBadge.textContent=translated('Pending Verification','சரிபார்ப்பு நிலுவையில் உள்ளது');

        postGate.className='status-banner pending';
        gateTitle.textContent=translated('Verification Pending','சரிபார்ப்பு நிலுவையில் உள்ளது');
        gateDesc.textContent=translated('Your employer account is currently pending administrator verification. Once verified by an administrator, you will be able to publish job listings.','உங்கள் நிறுவனக் கணக்கு தற்போது நிர்வாகியின் சரிபார்ப்புக்காக காத்திருக்கிறது. நிர்வாகி சரிபார்த்தவுடன் நீங்கள் வேலைகளை வெளியிடலாம்.');
        jobForm.classList.add('hidden');
      }

      const compName = employerProfile?.company_name || user.user_metadata?.company_name || '';
      const compArea = employerProfile?.area || user.user_metadata?.area || '';
      dashEmployerInfo.innerHTML = `<strong>${escapeHtml(translated('Company','நிறுவனம்'))}:</strong> ${escapeHtml(compName)} ${compArea ? `· ${escapeHtml(compArea)}` : ''}`;
      dashEmployerInfo.classList.remove('hidden');

      $('dashWorkerCard').classList.add('hidden');
      $('dashOwnerCard').classList.remove('hidden');
    } else {
      // Worker view
      dashVerifBadge.classList.add('hidden');
      dashPostJobBtn.classList.add('hidden');
      dashEmployerInfo.classList.add('hidden');

      postGate.className='status-banner worker';
      gateTitle.textContent=translated('Worker Account Active','தொழிலாளர் கணக்கு இயக்கத்தில் உள்ளது');
      gateDesc.textContent=translated('You are currently logged in as a Worker. Job postings are reserved for garment unit owners and employers.','நீங்கள் தற்போது தொழிலாளராக உள்நுழைந்துள்ளீர்கள். வேலைப் பதிவு நிறுவன உரிமையாளர்களுக்கானது.');
      jobForm.classList.add('hidden');

      $('dashWorkerCard').classList.remove('hidden');
      $('dashOwnerCard').classList.add('hidden');
    }

    // Account Profile Card inside Dashboard Section
    $('profileFullName').textContent = displayName;
    $('profileEmail').textContent = user.email;
    $('profileRoleTag').textContent = roleLabel;

    const verifTag=$('profileVerificationTag');
    const empBox=$('employerDetailsBox');

    if(role==='employer'){
      const vStatus = employerProfile?.verification_status || 'pending';
      verifTag.classList.remove('hidden');
      verifTag.className = (vStatus==='approved') ? 'tag' : 'tag tag-warn';
      verifTag.textContent = (vStatus==='approved')
        ? translated('Verified Employer','சரிபார்க்கப்பட்ட நிறுவனம்')
        : translated('Pending Verification','சரிபார்ப்பு நிலுவையில் உள்ளது');

      const compName = employerProfile?.company_name || user.user_metadata?.company_name || '';
      const compArea = employerProfile?.area || user.user_metadata?.area || '';
      empBox.innerHTML = `<strong>${escapeHtml(translated('Company','நிறுவனம்'))}:</strong> ${escapeHtml(compName)} ${compArea ? `· ${escapeHtml(compArea)}` : ''}`;
      empBox.classList.remove('hidden');
    } else {
      verifTag.classList.add('hidden');
      empBox.classList.add('hidden');
    }
  }

  async function handleLogout(){
    try{
      if(supabase){
        await supabase.auth.signOut();
      }
    }catch(e){
      console.warn('SignOut exception:', e);
    }finally{
      currentUser=null;
      $('loginForm').reset();
      $('loginStatus').textContent='';
      $('registerForm').reset();
      $('registerStatus').textContent='';
      renderAuthUI();
      window.scrollTo({top:0,behavior:'smooth'});
    }
  }
  $('profileLogoutBtn').addEventListener('click', handleLogout);
  $('dashLogoutBtn').addEventListener('click', handleLogout);

  // Login Form Submission
  $('loginForm').addEventListener('submit', async e=>{
    e.preventDefault();
    const email=$('loginEmail').value.trim();
    const password=$('loginPassword').value;
    const status=$('loginStatus');
    status.className='status';
    status.textContent=translated('Logging in…','உள்நுழைகிறது…');

    if(!supabase){
      status.className='status error';
      status.textContent=translated('Database client not ready.','தரவுத்தள இணைப்பு தயாராக இல்லை.');
      return;
    }

    const { data, error } = await supabase.auth.signInWithPassword({ email, password });
    if(error){
      status.className='status error';
      if(error.message.includes('Invalid login credentials')){
        status.textContent=translated('Incorrect email or password.','தவறான மின்னஞ்சல் அல்லது கடவுச்சொல்.');
      } else if(error.message.includes('Email not confirmed')){
        status.textContent=translated('Please confirm your email address before logging in.','உள்நுழைவதற்கு முன் உங்கள் மின்னஞ்சலை உறுதிப்படுத்தவும்.');
      } else {
        status.textContent=error.message;
      }
      return;
    }

    status.className='status success';
    status.textContent=translated('Login successful! Loading dashboard…','உள்நுழைவு வெற்றிகரமாக முடிந்தது!');
    $('loginForm').reset();
    await loadUserProfile(data.user);
    window.scrollTo({top:0,behavior:'smooth'});
  });

  // Register Form Submission
  $('registerForm').addEventListener('submit', async e=>{
    e.preventDefault();
    const fullName=$('regFullName').value.trim();
    const email=$('regEmail').value.trim();
    const password=$('regPassword').value;
    const phone=$('regPhone').value.trim();
    const roleChoice=$('userRole').value; // 'worker' or 'owner' (NEVER 'admin')
    const status=$('registerStatus');
    status.className='status';
    status.textContent=translated('Creating account…','கணக்கு உருவாக்கப்படுகிறது…');

    if(phone && !/^[0-9+() -]{10,18}$/.test(phone)){
      status.className='status error';
      status.textContent=translated('Enter a valid mobile number or leave blank.','சரியான கைபேசி எண்ணை உள்ளிடவும்.');
      return;
    }

    if(!supabase){
      status.className='status error';
      status.textContent=translated('Database client not ready.','தரவுத்தள இணைப்பு தயாராக இல்லை.');
      return;
    }

    const isEmployer = roleChoice==='owner';
    const companyName = isEmployer ? $('companyName').value.trim() : '';
    const area = isEmployer ? $('empArea').value : $('regArea').value;
    const skill = !isEmployer ? $('skills').value : '';

    if(isEmployer && !companyName){
      status.className='status error';
      status.textContent=translated('Please enter your company or unit name.','உங்கள் நிறுவனத்தின் பெயரை உள்ளிடவும்.');
      return;
    }

    const userMetadata = {
      full_name: fullName,
      phone: phone || null,
      intended_role: isEmployer ? 'employer' : 'worker',
      company_name: isEmployer ? companyName : null,
      area: area || null,
      skill: skill || null,
      preferred_language: lang
    };

    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      options: { data: userMetadata }
    });

    if(error){
      status.className='status error';
      if(error.message.includes('User already registered')){
        status.textContent=translated('An account with this email already exists. Please log in.','இந்த மின்னஞ்சலில் ஏற்கனவே கணக்கு உள்ளது. தயவுசெய்து உள்நுழையவும்.');
      } else {
        status.textContent=error.message;
      }
      return;
    }

    if(data.session && data.user){
      status.className='status success';
      status.textContent=translated('Account created! Loading dashboard…','கணக்கு உருவாக்கப்பட்டது! டாஷ்போர்டு திறக்கப்படுகிறது…');
      $('registerForm').reset();
      await loadUserProfile(data.user);
      window.scrollTo({top:0,behavior:'smooth'});
    } else {
      status.className='status success';
      if(isEmployer){
        status.textContent=translated(
          'Registration saved! Please check your email inbox to confirm your account. When you confirm and log in, your employer profile will be finalized for admin verification.',
          'பதிவு சேமிக்கப்பட்டது! உங்கள் கணக்கை உறுதிப்படுத்த மின்னஞ்சலைச் சரிபார்க்கவும். உறுதிசெய்து உள்நுழைந்ததும் நிறுவன சரிபார்ப்பு விவரம் முடிக்கப்படும்.'
        );
      } else {
        status.textContent=translated(
          'Registration saved! Please check your email inbox to confirm your account before logging in.',
          'பதிவு சேமிக்கப்பட்டது! உள்நுழைவதற்கு முன் உங்கள் கணக்கை உறுதிப்படுத்த மின்னஞ்சலைச் சரிபார்க்கவும்.'
        );
      }
      $('registerForm').reset();
    }
  });

  // Job Posting Form (Active only when verified)
  $('jobForm').addEventListener('submit', e=>{
    e.preventDefault();
    const phone=$('contactPhone').value.trim();
    if(!/^[0-9+() -]{10,18}$/.test(phone)){
      $('jobFormStatus').className='status error';$('jobFormStatus').textContent=translated('Enter a valid contact phone number.','சரியான தொலைபேசி எண்ணை உள்ளிடவும்.');return;
    }
    jobs.unshift({id:nextId++,title:$('jobTitle').value,company:$('company').value.trim(),area:$('jobArea').value,payType:$('payType').value,phone,description:$('jobDescription').value.trim(),created:Date.now(),demo:false});
    $('jobFormStatus').className='status success';$('jobFormStatus').textContent=translated('Job posted in this session. Once database job policies are verified, live publishing will be connected.','வேலை சேர்க்கப்பட்டது. தரவுத்தள கொள்கைகள் சரிபார்க்கப்பட்டதும் நேரலை இணைப்பு செயல்படுத்தப்படும்.');
    $('jobForm').reset();renderJobs();$('jobs').scrollIntoView({behavior:'smooth'});
  });

  // Initialize Select dropdowns
  fillAreaSelect('areaSelect',true);
  fillAreaSelect('jobArea');
  fillAreaSelect('regArea');
  fillAreaSelect('empArea');
  fillCategorySelect('jobTitle');
  fillCategorySelect('skills');
  jobs=demoJobs();
  renderCategories();
  renderJobs();

  // Initialize Supabase Auth Session and Listeners
  if(supabase){
    supabase.auth.onAuthStateChange(async (event, session)=>{
      if(event==='SIGNED_IN' || event==='TOKEN_REFRESHED' || event==='USER_UPDATED'){
        if(session?.user && (!currentUser || currentUser.user.id !== session.user.id)){
          await loadUserProfile(session.user);
        }
      } else if(event==='SIGNED_OUT'){
        currentUser=null;
        renderAuthUI();
      }
    });

    supabase.auth.getSession().then(async ({ data: { session } })=>{
      if(session?.user){
        await loadUserProfile(session.user);
      } else {
        currentUser=null;
        renderAuthUI();
      }
    }).catch(err=>{
      console.warn('Session check warning:', err);
      currentUser=null;
      renderAuthUI();
    });
  } else {
    renderAuthUI();
  }
})();
</script>
</body>
</html>